<div class="mb-4">
  <label class="block text-gray-300 mb-2 font-semibold">ငွေပေးချေမှု နည်းလမ်း ရွေးချယ်ပါ</label>
  <select id="paymentMethod" name="method" class="w-full p-2.5 bg-gray-800 text-white rounded-lg border border-gray-700 focus:outline-none focus:border-blue-500" onchange="updatePaymentDetails()">
    <option value="KBZPay">KBZ Pay</option>
    <option value="WavePay">Wave Money</option>
    <option value="UABPay">UAB Pay</option>
    <option value="AYAPay">AYA Pay</option>
  </select>
</div>

<!-- Account Information Display -->
<div id="paymentInfo" class="p-4 bg-gray-800 rounded-lg border border-gray-700 mb-4 text-center">
  <p id="accountType" class="font-bold text-blue-400 text-lg">KBZ Pay အကောင့်</p>
  <p id="accountNumber" class="text-2xl font-bold my-2 text-yellow-400 tracking-wider">09763442881</p>
  <p id="accountName" class="text-sm text-gray-300">Account Name: Safe Zone Topup</p>
</div>

<script>
  const paymentData = {
    KBZPay: { name: "KBZ Pay အကောင့်", number: "09763442881", accName: "Mg Pyae Phyo Kyaw" },
    WavePay: { name: "Wave Money အကောင့်", number: "09763442881", accName: "Mg Pyae Phyo Kyaw" },
    UABPay: { name: "UAB Pay အကောင့်", number: "09763442881", accName: "Mg Pyae Phyo Kyaw" },
    AYAPay: { name: "AYA Pay အကောင့်", number: "09763442881", accName: "Mg Pyae Phyo Kyaw" }
  };

  function updatePaymentDetails() {
    const selected = document.getElementById('paymentMethod').value;
    const info = paymentData[selected];
    document.getElementById('accountType').innerText = info.name;
    document.getElementById('accountNumber').innerText = info.number;
    document.getElementById('accountName').innerText = "Account Name: " + info.accName;
  }
</script>
