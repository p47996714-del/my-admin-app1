<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Safe Zone Game Topup</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #12131C; color: #fff; font-family: sans-serif; }
    
    /* Animated Glowing Logo Style */
    @keyframes pulseGlow {
      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(59, 130, 246, 0.8)); }
      50% { transform: scale(1.08); filter: drop-shadow(0 0 25px rgba(147, 51, 234, 0.9)); }
    }
    .animated-logo {
      animation: pulseGlow 3s infinite ease-in-out;
    }
  </style>
</head>
<body class="max-w-md mx-auto min-h-screen pb-16">

  <!-- AUTH SECTION -->
  <div id="auth-section" class="p-6 mt-6 bg-[#1E202E] rounded-2xl shadow-xl mx-4 border border-gray-800">
    
    <!-- Animated Logo Header -->
    <div class="flex flex-col items-center mb-6">
      <div class="animated-logo w-20 h-20 bg-gradient-to-tr from-blue-600 to-purple-600 rounded-2xl flex items-center justify-center text-3xl font-black shadow-lg mb-2 border border-blue-400/30">
        🎮
      </div>
      <h1 class="text-xl font-extrabold tracking-wider bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
        SAFE ZONE TOPUP
      </h1>
      <p class="text-xs text-gray-400 mt-1">Fast & Secure Game Service</p>
    </div>

    <h2 id="auth-title" class="text-lg font-bold text-center mb-4 text-gray-200">🔐 Login ဝင်ရန်</h2>
    
    <form id="auth-form" onsubmit="handleAuth(event)">
      <input type="text" id="name" placeholder="အမည်" class="hidden w-full p-3 mb-3 bg-[#12131C] border border-gray-700 rounded-xl text-white focus:outline-none focus:border-blue-500">
      
      <input type="text" id="phone" placeholder="ဖုန်းနံပါတ်" required class="w-full p-3 mb-3 bg-[#12131C] border border-gray-700 rounded-xl text-white focus:outline-none focus:border-blue-500">
      
      <input type="password" id="password" placeholder="စကားဝှက်" required class="w-full p-3 mb-3 bg-[#12131C] border border-gray-700 rounded-xl text-white focus:outline-none focus:border-blue-500">
      
      <!-- Register ပြုလုပ်မှ ပေါ်လာမည့် Confirm Password Field -->
      <input type="password" id="confirm-password" placeholder="စကားဝှက် ပြန်ရိုက်ပါ" class="hidden w-full p-3 mb-4 bg-[#12131C] border border-gray-700 rounded-xl text-white focus:outline-none focus:border-blue-500">
      
      <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:opacity-90 p-3 rounded-xl font-bold shadow-lg transition">
        ဝင်မည်
      </button>
    </form>
    
    <p class="text-center text-sm text-gray-400 mt-5 cursor-pointer" onclick="toggleAuth()">
      <span id="toggle-text" class="hover:text-blue-400 underline">အကောင့်မရှိသေးပါလား? Register လုပ်ပါ</span>
    </p>
  </div>

  <!-- DASHBOARD SECTION -->
  <div id="dashboard-section" class="hidden p-4">
    <!-- User Info Header -->
    <div class="bg-[#1E202E] p-4 rounded-2xl mb-4 flex justify-between items-center border border-gray-800 shadow-lg">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-blue-600/30 rounded-full flex items-center justify-center font-bold text-blue-400 border border-blue-500/30">
          👤
        </div>
        <div>
          <h3 id="user-display-name" class="font-bold text-base">---</h3>
          <p id="user-display-phone" class="text-xs text-gray-400">---</p>
        </div>
      </div>
      <div class="text-right">
        <span class="text-xs text-gray-400">လက်ကျန်ငွေ</span>
        <div class="text-lg font-extrabold text-blue-400"><span id="user-balance">0</span> Ks</div>
      </div>
    </div>

    <!-- Deposit Button -->
    <button onclick="openDepositModal()" class="w-full bg-gradient-to-r from-blue-600 to-purple-600 p-3.5 rounded-2xl font-bold mb-6 shadow-lg hover:opacity-90 transition">
      💳 ငွေဖြည့်မည် (Deposit)
    </button>

    <!-- Games Section -->
    <h3 class="font-bold text-md mb-3 text-gray-300">🎮 ဂိမ်းများ ရွေးချယ်ပါ</h3>
    <div class="grid grid-cols-2 gap-3">
      <div class="bg-[#1E202E] p-4 rounded-2xl text-center border border-gray-800 hover:border-blue-500/50 transition">
        <div class="h-20 bg-blue-900/30 rounded-xl mb-2 flex items-center justify-center font-bold text-blue-400 text-lg border border-blue-500/20">MLBB</div>
        <p class="font-bold text-sm">Mobile Legends</p>
      </div>
      <div class="bg-[#1E202E] p-4 rounded-2xl text-center border border-gray-800 hover:border-yellow-500/50 transition">
        <div class="h-20 bg-yellow-900/30 rounded-xl mb-2 flex items-center justify-center font-bold text-yellow-400 text-lg border border-yellow-500/20">PUBG</div>
        <p class="font-bold text-sm">PUBG Mobile</p>
      </div>
    </div>
  </div>

  <!-- DEPOSIT MODAL -->
  <div id="deposit-modal" class="hidden fixed inset-0 bg-black/80 flex items-end justify-center p-4 z-50">
    <div class="bg-[#1E202E] w-full max-w-md p-6 rounded-t-3xl border-t border-gray-700">
      <div class="flex justify-between items-center mb-4">
        <h3 class="font-bold text-lg">💳 ငွေဖြည့်ရန်</h3>
        <button onclick="closeDepositModal()" class="text-gray-400 text-xl font-bold">✕</button>
      </div>
      <form onsubmit="handleDeposit(event)">
        <input type="number" id="dep-amount" placeholder="ပမာဏ (Ks)" required class="w-full p-3 mb-3 bg-[#12131C] border border-gray-700 rounded-xl text-white focus:outline-none focus:border-blue-500">
        <select id="dep-method" class="w-full p-3 mb-4 bg-[#12131C] border border-gray-700 rounded-xl text-white focus:outline-none">
          <option value="KBZPay">KBZ Pay</option>
          <option value="WavePay">Wave Pay</option>
          <option value="AYAPay">AYA Pay</option>
        </select>
        <button type="submit" class="w-full bg-green-600 hover:bg-green-700 p-3 rounded-xl font-bold transition">ငွေဖြည့်မည်</button>
      </form>
    </div>
  </div>

  <script>
    let isRegister = false;
    let currentUser = null;

    function toggleAuth() {
      isRegister = !isRegister;
      document.getElementById('name').classList.toggle('hidden', !isRegister);
      document.getElementById('confirm-password').classList.toggle('hidden', !isRegister);
      
      document.getElementById('auth-title').innerText = isRegister ? '📝 Register ပြုလုပ်ရန်' : '🔐 Login ဝင်ရန်';
      document.getElementById('toggle-text').innerText = isRegister ? 'အကောင့်ရှိပြီးသားလား? Login ဝင်ပါ' : 'အကောင့်မရှိသေးပါလား? Register လုပ်ပါ';
    }

    async function handleAuth(e) {
      e.preventDefault();
      
      const phone = document.getElementById('phone').value;
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirm-password').value;

      // Password နှစ်ခါ တိုက်စစ်ခြင်း (Register လုပ်ချိန်၌သာ)
      if (isRegister) {
        if (password !== confirmPassword) {
          alert("စကားဝှက် နှစ်ခု တူညီမှု မရှိပါ။ ကျေးဇူးပြု၍ ပြန်လည်စစ်ဆေးပါ။");
          return;
        }
      }

      const endpoint = isRegister ? '/api/register' : '/api/login';
      const body = {
        name: document.getElementById('name').value,
        phone: phone,
        password: password
      };

      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (data.success) {
        currentUser = data.user;
        showDashboard();
      } else {
        alert(data.message);
      }
    }

    function showDashboard() {
      document.getElementById('auth-section').classList.add('hidden');
      document.getElementById('dashboard-section').classList.remove('hidden');
      document.getElementById('user-display-name').innerText = currentUser.name || 'User';
      document.getElementById('user-display-phone').innerText = currentUser.phone;
      document.getElementById('user-balance').innerText = currentUser.balance;
    }

    function openDepositModal() { document.getElementById('deposit-modal').classList.remove('hidden'); }
    function closeDepositModal() { document.getElementById('deposit-modal').classList.add('hidden'); }

    async function handleDeposit(e) {
      e.preventDefault();
      const body = {
        userId: currentUser._id,
        userName: currentUser.name || currentUser.phone,
        amount: Number(document.getElementById('dep-amount').value),
        method: document.getElementById('dep-method').value
      };

      const res = await fetch('/api/deposit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      alert(data.message);
      closeDepositModal();
    }
  </script>
</body>
</html>
