<!DOCTYPE html>
<html>
<head>
  <title>Topup Admin Panel</title>
  <style>
    body { font-family: sans-serif; padding: 20px; background: #f0f2f5; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; background: white; }
    th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
    th { background: #007bff; color: white; }
    .btn-approve { background: green; color: white; border: none; padding: 6px 12px; cursor: pointer; border-radius: 4px; }
  </style>
</head>
<body>
  <h1>Admin Management Panel</h1>

  <h2>💳 ငွေဖြည့်တောင်းဆိုမှုများ (Deposits)</h2>
  <table>
    <tr>
      <th>User Name</th>
      <th>Amount</th>
      <th>Method</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
    <% deposits.forEach(dep => { %>
      <tr>
        <td><%= dep.userName %></td>
        <td><%= dep.amount %> Ks</td>
        <td><%= dep.method %></td>
        <td><strong><%= dep.status %></strong></td>
        <td>
          <% if(dep.status === 'Pending') { %>
            <form action="/admin/approve-deposit/<%= dep._id %>" method="POST" style="margin:0;">
              <button class="btn-approve">Approve & Add Balance</button>
            </form>
          <% } else { %>
            Done
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table>

  <h2>👥 User များ စာရင်း</h2>
  <table>
    <tr>
      <th>Name</th>
      <th>Phone</th>
      <th>Balance</th>
    </tr>
    <% users.forEach(u => { %>
      <tr>
        <td><%= u.name || 'N/A' %></td>
        <td><%= u.phone %></td>
        <td><%= u.balance %> Ks</td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
